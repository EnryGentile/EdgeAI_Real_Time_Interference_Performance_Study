Names Default To Here( 1 );

// ==============================================================================
// IMPORTANZA E SIGNIFICATIVITA DEI FATTORI DoE (Traccia A1)
//
// Fattori sperimentali:
//   - 1. Carico worker (num_workers: 25% N_tot, 50% N_tot, 75% N_tot, N_tot)
//   - 2. Working-set size (size: 25% S_tot, 50% S_tot, 75% S_tot) - presente SOLO per mem e io.
//   - La durata e costante e fissata al tempo totale (duration: t_tot), quindi non e un fattore.
// ==============================================================================

// 1. Configurazione percorsi di salvataggio
outputDir = "$DESKTOP/Universita/Magistrale/Real-Time Systems and Industrial Applications/EdgeAI_Real_Time_Interference_Performance_Study/figures/doe_analysis/";
If( !Directory Exists( outputDir ),
	Create Directory( outputDir )
);

// 2. Selezione ed apertura tabella dati DoE
// Prova prima i percorsi standard del progetto, con fallback su selezione interattiva
defaultCsv1 = "$DESKTOP/Universita/Magistrale/Real-Time Systems and Industrial Applications/EdgeAI_Real_Time_Interference_Performance_Study/results/doe_slm-1b_gpu_mmlu_cpu.csv";
defaultCsv2 = "$DESKTOP/Universita/Magistrale/Real-Time Systems and Industrial Applications/EdgeAI_Real_Time_Interference_Performance_Study/doe_example.csv";

csvPath = "";
If( File Exists( defaultCsv1 ),
	csvPath = defaultCsv1;
,
	If( File Exists( defaultCsv2 ),
		csvPath = defaultCsv2;
	,
		csvPath = Pick File( "Seleziona il file DoE CSV (results/doe_*.csv)", "", {"File CSV|csv", "Tutti i file|*"} );
	)
);

If( csvPath == "",
	Print( "[ERRORE] Nessun file DoE selezionato. Script interrotto." );
	Stop();
);

Print( "Apertura tabella DoE: " || csvPath );
table1 = Open( csvPath );

// 3. Filtraggio Durata (DoE analizzato esclusivamente per duration = 't_tot')
colNames = table1 << Get Column Names( "String" );
If( Contains( colNames, "duration" ),
	durVals = Associative Array( Column( table1, "duration" ) << Get Values );
	If( Contains( durVals, "t_tot" ),
		table1 << Select Where( :duration != "t_tot" );
		nNonTot = N Row( table1 << Get Selected Rows );
		If( nNonTot > 0,
			Print( "Filtro applicato: selezionati esclusivamente i dati con durata totale (duration = 't_tot')." );
			tableFiltered = table1 << Subset( Selected Rows( 0 ), Selected columns only( 0 ) );
			Close( table1, NoSave );
			table1 = tableFiltered;
		);
		table1 << Clear Select;
	);
);

// 4. Configurazione tipi di modellazione delle colonne
metricCols = {"ttft_ms", "per_token_lat_ms", "throughput_tok_s", "jitter_ms"};
For( m = 1, m <= N Items( metricCols ), m++,
	If( Contains( colNames, metricCols[m] ),
		Column( table1, metricCols[m] ) << Set Modeling Type( "Continuous" );
		Column( table1, metricCols[m] ) << Set Data Type( "Numeric" );
	)
);

Column( table1, "num_workers" ) << Set Modeling Type( "Nominal" );
Column( table1, "num_workers" ) << Set Data Type( "Character" );

// Rilevamento presenza del fattore 'size' (stressor 3D: mem, io)
hasSize = 0;
If( Contains( colNames, "size" ),
	sizeVals = Associative Array( Column( table1, "size" ) << Get Values );
	sizeVals << Remove( "." );
	sizeVals << Remove( "" );
	sizeVals << Remove( "N/A" );
	sizeVals << Remove( "NaN" );
	sizeVals << Remove( "none" );
	If( N Items( sizeVals ) > 1,
		hasSize = 1;
		Column( table1, "size" ) << Set Modeling Type( "Nominal" );
		Column( table1, "size" ) << Set Data Type( "Character" );
	);
);

// 5. Costruzione del modello ANOVA (Fit Model)
// Effetti:
//  - DoE 3D: num_workers, size, num_workers * size
//  - DoE 2D: num_workers
// Nota: 'duration' NON e inclusa negli effetti perche e fissa a t_tot (DF=0 genererebbe singolarita)
responses = {"ttft_ms", "per_token_lat_ms", "throughput_tok_s", "jitter_ms"};

If( hasSize,
	Print( "-> Modello DoE 3D: Fattori attivi = [:num_workers, :size] con interazione (Durata fissa t_tot)" );
	factors = {"num_workers", "size"};
	fmObj = table1 << Fit Model(
		Y( :ttft_ms, :per_token_lat_ms, :throughput_tok_s, :jitter_ms ),
		Effects( :num_workers, :size, :num_workers * :size ),
		Personality( "Standard Least Squares" ),
		Emphasis( "Effect Leverage" ),
		Run(
			:ttft_ms << {
				Summary of Fit( 1 ), Analysis of Variance( 1 ), Parameter Estimates( 1 ), Plot Actual by Predicted( 1 )
			},
			:per_token_lat_ms << {
				Summary of Fit( 1 ), Analysis of Variance( 1 ), Parameter Estimates( 1 ), Plot Actual by Predicted( 1 )
			},
			:throughput_tok_s << {
				Summary of Fit( 1 ), Analysis of Variance( 1 ), Parameter Estimates( 1 ), Plot Actual by Predicted( 1 )
			},
			:jitter_ms << {
				Summary of Fit( 1 ), Analysis of Variance( 1 ), Parameter Estimates( 1 ), Plot Actual by Predicted( 1 )
			}
		)
	);
,
	Print( "-> Modello DoE 2D: Fattore attivo = [:num_workers] (Durata fissa t_tot, size assente)" );
	factors = {"num_workers"};
	fmObj = table1 << Fit Model(
		Y( :ttft_ms, :per_token_lat_ms, :throughput_tok_s, :jitter_ms ),
		Effects( :num_workers ),
		Personality( "Standard Least Squares" ),
		Emphasis( "Effect Leverage" ),
		Run(
			:ttft_ms << {
				Summary of Fit( 1 ), Analysis of Variance( 1 ), Parameter Estimates( 1 ), Plot Actual by Predicted( 1 )
			},
			:per_token_lat_ms << {
				Summary of Fit( 1 ), Analysis of Variance( 1 ), Parameter Estimates( 1 ), Plot Actual by Predicted( 1 )
			},
			:throughput_tok_s << {
				Summary of Fit( 1 ), Analysis of Variance( 1 ), Parameter Estimates( 1 ), Plot Actual by Predicted( 1 )
			},
			:jitter_ms << {
				Summary of Fit( 1 ), Analysis of Variance( 1 ), Parameter Estimates( 1 ), Plot Actual by Predicted( 1 )
			}
		)
	);
);

repFM = Report( fmObj );

// Forza l'apertura a video di tutti i riquadri
allBoxes = repFM << XPath( "//OutlineBox" );
For( b = 1, b <= N Items( allBoxes ), b++,
	allBoxes[b] << Close( 0 );
);

// Salva panoramica generale del modello
repFM << Save Picture( outputDir || "all_fit_models_summary.png", "PNG" );

// Genera le colonne dei residui
fmObj << Residuals;

// 6. Analisi Distribuzioni dei Residui con test di Shapiro-Wilk
distObj = table1 << Distribution(
	Stack( 1 ),
	Continuous Distribution( Column( :Residual jitter_ms ), Quantile Box Plot( 1 ), Fit Normal( Goodness of Fit( 1 ) ), Normal Quantile Plot( 1 ) ),
	Continuous Distribution( Column( :Residual throughput_tok_s ), Quantile Box Plot( 1 ), Fit Normal( Goodness of Fit( 1 ) ), Normal Quantile Plot( 1 ) ),
	Continuous Distribution( Column( :Residual per_token_lat_ms ), Quantile Box Plot( 1 ), Fit Normal( Goodness of Fit( 1 ) ), Normal Quantile Plot( 1 ) ),
	Continuous Distribution( Column( :Residual ttft_ms ), Quantile Box Plot( 1 ), Fit Normal( Goodness of Fit( 1 ) ), Normal Quantile Plot( 1 ) )
);

repDist = Report( distObj );
repDist << Save Picture( outputDir || "all_residuals_distributions.png", "PNG" );

// 7. Ciclo di analisi per ciascuna metrica di prestazione
For( r = 1, r <= N Items( responses ), r++,
	respName = responses[r];
	resColName = "Residual " || respName;
	
	Print( "=========================================================" );
	Print( "ANALISI PER LA METRICA: " || respName );
	Print( "=========================================================" );
	
	responseBox = repFM[Outline Box( "Response " || respName )];
	
	// A. Esportazione del Grafico "Actual by Predicted Plot"
	Try(
		actByPredBox = responseBox[Outline Box( "Actual by Predicted Plot" )];
		actByPredBox << Save Picture( outputDir || "actual_by_predicted_" || respName || ".png", "PNG" );
	,
		Try(
			actByPredBox = responseBox[Outline Box( "Grafico delle risposte osservate rispetto alle risposte previste" )];
			actByPredBox << Save Picture( outputDir || "actual_by_predicted_" || respName || ".png", "PNG" );
		)
	);
	
	// B. Calcolo dell'Importanza (% Devianza Spiegata SS/SST)
	ssError = .; sst = .;
	Try(
		ssError = responseBox[Outline Box( "Analysis of Variance" )][Number Col Box( "Sum of Squares" )][2];
		sst     = responseBox[Outline Box( "Analysis of Variance" )][Number Col Box( "Sum of Squares" )][3];
		ssEffects   = responseBox[Outline Box( "Effect Tests" )][Number Col Box( "Sum of Squares" )] << Get;
		effectNames = responseBox[Outline Box( "Effect Tests" )][String Col Box( "Source" )] << Get;
	,
		ssError = responseBox[Outline Box( "Analisi della varianza" )][Number Col Box( "Somma dei quadrati" )][2];
		sst     = responseBox[Outline Box( "Analisi della varianza" )][Number Col Box( "Somma dei quadrati" )][3];
		ssEffects   = responseBox[Outline Box( "Test degli effetti" )][Number Col Box( "Somma dei quadrati" )] << Get;
		effectNames = responseBox[Outline Box( "Test degli effetti" )][String Col Box( "Origine" )] << Get;
	);
	
	Print( "--- ANALISI DI IMPORTANZA DEI FATTORI (SS/SST) ---" );
	For( i = 1, i <= N Items( effectNames ), i++,
		imp = (ssEffects[i] / sst) * 100;
		Print( "Effetto [" || effectNames[i] || "]: SS = " || Char( Round( ssEffects[i], 4 ) ) || " | Quota: " || Char( Round( imp, 2 ) ) || " %" );
	);
	impErr = (ssError / sst) * 100;
	Print( "Errore Sperimentale (Residui): SS = " || Char( Round( ssError, 4 ) ) || " | Quota: " || Char( Round( impErr, 2 ) ) || " %" );
	
	responseBox << Save Picture( outputDir || "model_report_" || respName || ".png", "PNG" );
	
	// C. Estrazione del test di Shapiro-Wilk sui Residui
	resDistBox = repDist[Outline Box( resColName )];
	resDistBox << Save Picture( outputDir || "distribution_" || resColName || ".png", "PNG" );
	
	shapiroPVal = .;
	Try(
		shapiroPVal = resDistBox[Outline Box( "Goodness-of-Fit Test" )][Number Col Box( "Prob < W" )][1];
	,
		shapiroPVal = resDistBox[Outline Box( "Bonta dell'adattamento" )][Number Col Box( "Prob < W" )][1];
	);
	
	Print( "Test Shapiro-Wilk sui Residui: Prob < W = " || Char( shapiroPVal ) );
	
	// D. Valutazione Significativita: ANOVA (se p >= 0.05) vs Kruskal-Wallis (se p < 0.05)
	If( !Is Missing( shapiroPVal ) & shapiroPVal >= 0.05,
		Print( "ESITO: Residui Normali (p >= 0.05). Valutazione F-Test (ANOVA):" );
		pF = .;
		Try(
			pF = responseBox[Outline Box( "Effect Tests" )][Number Col Box( "Prob > F" )] << Get;
		,
			pF = responseBox[Outline Box( "Test degli effetti" )][Number Col Box( "Prob > F" )] << Get;
		);
		For( i = 1, i <= N Items( effectNames ), i++,
			sigLabel = If( pF[i] < 0.05, "SIGNIFICATIVO (p < 0.05)", "NON significativo" );
			Print( " - " || effectNames[i] || " -> Prob > F = " || Char( pF[i] ) || " [" || sigLabel || "]" );
		);
	,
		Print( "ESITO: Residui NON Normali (p < 0.05). Valutazione Non Parametrica (Kruskal-Wallis):" );
		For( j = 1, j <= N Items( factors ), j++,
			fName = factors[j];
			kw = table1 << Oneway(
				Y( Column( respName ) ),
				X( Column( fName ) ),
				Wilcoxon Test( 1 )
			);
			repKW = Report( kw );
			
			pKW = .;
			Try(
				pKW = repKW[Outline Box( "Kruskal-Wallis Test" )][Number Col Box( "Prob > ChiSq" )][1];
			,
				pKW = repKW[Outline Box( "Test di Kruskal-Wallis" )][Number Col Box( "Prob > Chi-quadro" )][1];
			);
			
			sigLabel = If( pKW < 0.05, "SIGNIFICATIVO (p < 0.05)", "NON significativo" );
			Print( " - Fattore " || fName || " -> Prob > Chi-quadro = " || Char( pKW ) || " [" || sigLabel || "]" );
			
			repKW << Save Picture( outputDir || "kruskal_wallis_" || respName || "_" || fName || ".png", "PNG" );
			kw << Close Window;
		);
	);
);

Print( "Tutti i grafici e i calcoli statistici sono stati esportati in: " || outputDir );
